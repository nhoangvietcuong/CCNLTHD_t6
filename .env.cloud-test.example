# Copy to .env.cloud-test.local; use ONLY your separate development project.
# Confirm Standard edition + Spark in Firebase Console; code cannot verify your billing plan.

# Firebase Cloud Test - Development
FIREBASE_CLOUD_TEST_PROJECT_ID=nextbooks-dev

NEXT_PUBLIC_FIREBASE_PROJECT_ID=nextbooks-dev
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false


# Server-only values from the SAME development project's service account.
FIREBASE_ADMIN_PROJECT_ID=nextbooks-dev
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@nextbooks-dev.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\"